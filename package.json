{
  "name": "talbs-me",
  "scripts": {
    "build": "node tools/build.js",
    "check": "node tools/build.js --check",
    "dev": "node tools/serve.js & node --watch-path=src --watch-path=assets --watch-path=tools tools/build.js",
    "format": "prettier --write '{src,tools,test}/**/*.{js,html,css}' '*.{js,json}' '.github/**/*.yml'",
    "test": "prettier --check '{src,tools,test}/**/*.{js,html,css}' '*.{js,json}' '.github/**/*.yml' && eslint src/styles.css && node --test && TZ=Asia/Tokyo node --test && node tools/build.js --check"
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "@awesome.me/webawesome": "3.14.0",
    "@fontsource/chivo": "^5.3.0",
    "@fontsource/chivo-mono": "^5.3.0",
    "tiny-tells": "0.4.0"
  },
  "devDependencies": {
    "@eslint/css": "^2.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10"
  }
}
