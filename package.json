{
  "name": "talbs-me",
  "scripts": {
    "build": "node build.js",
    "check": "node build.js --check",
    "dev": "node serve.js & node --watch-path=index.html --watch-path=styles.css --watch-path=page.js --watch-path=enhance.js --watch-path=clock.js --watch-path=schedule.js --watch-path=sky.js --watch-path=statuses.js --watch-path=links.js --watch-path=tray.js --watch-path=stars.js --watch-path=music.js --watch-path=day.js --watch-path=prune.js --watch-path=weather.js build.js",
    "format": "prettier --write '*.{js,html,css,json}' '.github/**/*.yml'",
    "test": "prettier --check '*.{js,html,css,json}' '.github/**/*.yml' && eslint styles.css && node --test && TZ=Asia/Tokyo node --test && node build.js --check"
  },
  "type": "module",
  "private": true,
  "dependencies": {
    "@awesome.me/webawesome": "3.14.0",
    "@fontsource/chivo": "^5.3.0",
    "@fontsource/chivo-mono": "^5.3.0",
    "tiny-tells": "0.4.0"
  },
  "devDependencies": {
    "@eslint/css": "^2.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "prettier": "^3.9.10"
  }
}
